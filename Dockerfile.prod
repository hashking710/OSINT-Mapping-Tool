FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:22-alpine

WORKDIR /app

COPY --from=build /app/dist ./dist
COPY docker/entrypoint.prod.sh docker/write-config.cjs docker/server.mjs ./docker/

ENV PORT=4173

EXPOSE 4173

CMD ["sh", "/app/docker/entrypoint.prod.sh"]